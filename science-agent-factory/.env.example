# 内部 Builder / Distiller / Auditor 的 Codex SDK 认证。
SAF_CODEX_BASE_URL=
SAF_CODEX_API_KEY=

# ChatGPT 订阅认证仅供可信的私有 Worker 使用；目录必须在仓库和导出目录之外，
# 且目录权限为 0700、auth.json 权限为 0600。代理是网络出口，不是自定义 API 网关。
SAF_CODEX_ACCOUNT_HOME=~/.codex
SAF_CODEX_NETWORK_PROXY=
# 原生 Harbor 示例引用的凭据；具体变量由所选 harness 决定。
SAF_HARBOR_BASE_URL=
SAF_HARBOR_API_KEY=

# 可选：由本机向无 OpenAI 直连出口的服务器建立 SSH 反向隧道时使用。
SAF_SSH_TARGET=
SAF_LOCAL_PROXY_HOST=127.0.0.1
SAF_LOCAL_PROXY_PORT=7897
SAF_REMOTE_PROXY_PORT=17897

# 可选：把 SAF 的 Docker 操作路由到项目专用的 rootless Docker（无根 Docker）守护进程。
# 服务器应填写实际 UID 对应的绝对 socket 路径，例如 unix:///run/user/1000/saf-docker.sock。
SAF_DOCKER_HOST=
# 可选：专用 Docker 的数据与运行元数据根目录，建议位于大容量数据盘。
SAF_ROOTLESS_DOCKER_ROOT=
