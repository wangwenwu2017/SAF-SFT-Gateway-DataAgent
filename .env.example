# SAF-SFT-Gateway 统一环境变量模板（仅占位符，不含真实值）。
# 两个子项目各自也会读取所在目录的 .env.example；真实值请写入对应 .env（已被 .gitignore 忽略）。

# ---- Science Agent Factory：内部 Builder / Distiller / Auditor 的 Codex SDK 认证 ----
SAF_CODEX_BASE_URL=
SAF_CODEX_API_KEY=
# ChatGPT 订阅认证仅供可信私有 Worker 使用；目录须在仓库与导出目录之外，权限 0700，auth.json 0600。
SAF_CODEX_ACCOUNT_HOME=~/.codex
SAF_CODEX_NETWORK_PROXY=
# Harbor harness 的凭据（变量名由所选 harness 决定）。
SAF_HARBOR_BASE_URL=
SAF_HARBOR_API_KEY=
# 可选：SSH 反向隧道。
SAF_SSH_TARGET=
SAF_LOCAL_PROXY_HOST=127.0.0.1
SAF_LOCAL_PROXY_PORT=7897
SAF_REMOTE_PROXY_PORT=17897
# 可选：把 SAF 的 Docker 操作路由到专用 rootless Docker 守护进程。
SAF_DOCKER_HOST=
SAF_ROOTLESS_DOCKER_ROOT=

# ---- SFT Gateway：计费上游 key 只留在网关端，容器只拿 gateway key ----
SFT_UPSTREAM_URL=https://your-relay.example/v1
SFT_UPSTREAM_API_KEY=
SFT_GATEWAY_API_KEY=
SFT_ADMIN_API_KEY=
SFT_DB=data/gateway.sqlite
SFT_REQUEST_TIMEOUT=900
SFT_STRIP_CODEX_INTERNAL_METADATA=0